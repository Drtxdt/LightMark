{
  "name": "lightmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LightMark - a lightweight Markdown desktop editor MVP.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:app": "tauri build --no-bundle",
    "tauri:build:all": "tauri build --bundles msi nsis",
    "check:wiki-links": "node scripts/check-wiki-links.mjs",
    "check:editor-position": "node scripts/check-editor-position.mjs",
    "check:split-layout": "node scripts/check-split-layout.mjs",
    "check:input-rules": "node scripts/check-input-rules.mjs",
    "check:markdown-format": "node scripts/check-markdown-format.mjs",
    "check:breadcrumbs": "node scripts/check-breadcrumbs.mjs",
    "check:outline-folding": "node scripts/check-outline-folding.mjs",
    "check:math": "node scripts/check-math.mjs",
    "check:tables": "node scripts/check-table-roundtrip.mjs",
    "check:editor-history": "node scripts/check-editor-history.mjs",
    "check:export-preparation": "node scripts/check-export-preparation.mjs",
    "check:front-matter": "node scripts/check-front-matter.mjs",
    "check:writing-modes": "node scripts/check-writing-modes.mjs",
    "check:image-layout": "node scripts/check-image-layout.mjs",
    "check:document-assets": "node scripts/check-document-assets.mjs",
    "check:smart-paste": "node scripts/check-smart-paste.mjs",
    "check:regression-closures": "node scripts/check-regression-closures.mjs",
    "check:math-tools-cli": "node scripts/check-math-tools-cli.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.24.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-code-block-lowlight": "^3.23.5",
    "@tiptap/extension-heading": "^3.11.0",
    "@tiptap/extension-image": "^3.11.0",
    "@tiptap/extension-link": "^3.11.0",
    "@tiptap/extension-table": "^3.23.5",
    "@tiptap/extension-table-cell": "^3.23.5",
    "@tiptap/extension-table-header": "^3.23.5",
    "@tiptap/extension-table-row": "^3.23.5",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@tiptap/vue-3": "^3.11.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.1",
    "turndown": "^7.2.2",
    "vue": "^3.5.25",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.9.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.5"
  },
  "packageManager": "pnpm@10.32.1"
}
